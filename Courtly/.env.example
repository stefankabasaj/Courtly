# Copy this to .env - NEVER commit .env (already in .gitignore)

# PostgreSQL
POSTGRES_DB=courtly
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password

# Database host
# localhost when running app locally
# postgres  set automatically by docker-compose for the app container
DB_HOST=localhost
DB_PORT=5432

# JWT secret - generate with: openssl rand -base64 64
# Must be at least 32 characters
JWT_SECRET=your-minimum-32-character-secret-key-here
JWT_EXPIRATION_MS=86400000

# Admin account, created on first start (or unlocked, for the old seeded
# admin@courtly.com). An existing password is never overwritten.
# Password: at least 12 characters - generate with: openssl rand -base64 18
ADMIN_EMAIL=admin@courtly.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Unpaid bookings are cancelled after this long (Spring duration: 15m, 1h, ...)
BOOKING_PAYMENT_TIMEOUT=15m

# Copy this to .env - NEVER commit .env (already in .gitignore)

# PostgreSQL
POSTGRES_DB=courtly
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password

# Database host
# localhost when running app locally
# postgres when running in docker compose (set automatically for the app container)
DB_HOST=localhost
DB_PORT=5432

# JWT secret (the app refuses to start with the placeholder below) - generate with: openssl rand -base64 64
# Must be at least 32 characters
JWT_SECRET=your-minimum-32-character-secret-key-here
JWT_EXPIRATION_MS=86400000

# Admin account, created on first start (or unlocked, for the old seeded
# admin@courtly.com). An existing password is never overwritten.
# The app refuses to start with the placeholder password below.
# Password: at least 12 characters - generate with: openssl rand -base64 18
ADMIN_EMAIL=admin@courtly.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Unpaid bookings one user can hold at once
BOOKING_MAX_PENDING_PER_USER=3

# Unpaid bookings are cancelled after this long (Spring duration: 15m, 1h, ...)
BOOKING_PAYMENT_TIMEOUT=15m

# The courts' time zone. Booking times are local wall-clock time in this zone
APP_TIMEZONE=Europe/Belgrade

# Login and registration limits (defaults shown)
# LOGIN_MAX_FAILURES_PER_EMAIL=5            # one email from one IP
# LOGIN_MAX_FAILURES_PER_EMAIL_ALL_IPS=20   # one email from every IP together
# LOGIN_MAX_FAILURES_PER_IP=20
# REGISTER_MAX_PER_IP=10                    # accounts per IP per REGISTER_WINDOW (1h)

# Swagger UI / OpenAPI JSON. On by default, off with SPRING_PROFILES_ACTIVE=prod
# API_DOCS_ENABLED=true
